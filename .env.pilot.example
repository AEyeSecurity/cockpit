# Copy to a local .env.pilot. Keep actual endpoints and key paths out of Git.
COCKPIT_PILOT_WEB_IMAGE=cockpit-web-pilot:dev
COCKPIT_PILOT_AUTH_IMAGE=cockpit-auth:dev
COCKPIT_PILOT_REVISION=dev
COCKPIT_PILOT_PORT=5180
COCKPIT_ORIGIN=https://cockpit-pilot.example.com
COCKPIT_KEYS_PATH=/path/outside/checkout/keys.json
COCKPIT_NAVIGATION_URL=ws://robot-private.example:8766/
COCKPIT_SIMULATION_URL=
COCKPIT_ROSBRIDGE_URL=
COCKPIT_DISPATCH_URL=
COCKPIT_VISION_URL=
COCKPIT_PERSON_URL=
COCKPIT_MJPEG_URL=
COCKPIT_CAMERA_URL=
COCKPIT_RECORDINGS_URL=
COCKPIT_PASSWORD_ONLY=false
COCKPIT_KEEP_CONNECTIONS=false
